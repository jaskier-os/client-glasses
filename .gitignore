# Android / Gradle build output
build/
*/build/
**/build/
.gradle/
**/.gradle/
.cxx/
**/.cxx/
*.apk
*.aab
*.ap_
*.dex

# Native build intermediates
**/obj/
**/.externalNativeBuild/

# Local SDK / machine-specific config (never commit; see local.properties.example)
local.properties
**/local.properties

# Keystores / signing material (never commit)
*.jks
*.keystore
keystore.properties
google-services.json

# Certificates / keys (optional TLS; never commit)
*.pem
*.crt
*.key
*.p12
*.pfx

# Secrets
.env
.env.local
.env.*.local

# IDE
.idea/
*.iml
.vscode/
.DS_Store

# Logs / scratch / runtime dumps
*.log
hs_err_pid*.log
*.raw
*.pcm
*.hprof

# Generated QNN / native artifacts (regenerated by sthal/tools/compile_onnx_to_qnn.sh)
sthal/build/
sthal/build-qnn/
sthal/acd-probe/build/
sthal/acd-probe/logs/

# Test screenshots / captures / datasets
test/screenshots/
nightvision_dataset/

# Python caches (test tooling)
__pycache__/
*.pyc
.pytest_cache/
