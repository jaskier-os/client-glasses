<?xml version="1.0" encoding="utf-8"?>
<!--
  A single tap: the contact point plus the ripple it makes.

  Drawn at the same 12dp/24vp footprint as ic_mic so the two sit level in the RC
  thread footer. Monochrome by construction: the waveguide emits green for any
  non-black pixel, so the fill colour is the palette's GLOW and nothing relies on
  hue to carry meaning.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="12dp"
    android:height="12dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- contact point -->
    <path
        android:fillColor="#00FF00"
        android:pathData="M12,9m-3.2,0a3.2,3.2 0 1,0 6.4,0a3.2,3.2 0 1,0 -6.4,0" />
    <!-- ripple, open at the bottom so it reads as a downward press -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#00FF00"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:pathData="M5.6,15.2a8,8 0 0,1 0,-11.4 M18.4,3.8a8,8 0 0,1 0,11.4" />
</vector>
