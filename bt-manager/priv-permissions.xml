<?xml version="1.0" encoding="utf-8"?>
<!--
  privapp-permissions-com.repository.glasses.btmanager.xml

  Grants the signature|privileged permissions required by the bt-manager APK
  on a device where the app is NOT signed with the platform key. Required
  for BluetoothA2dpSink.connect / BluetoothHeadsetClient.connect / setConnectionPolicy
  used by ProfileAutoConnector to bring HFP-HF and A2DP Sink up after pairing.

  IMPORTANT: this block MUST list at least two permissions. On a fresh first
  boot, Android 12 PMS drops a SINGLE-permission <privapp-permissions> block,
  and the priv-app then fails the systemReady() allowlist check -- which throws
  in system_server and BOOTLOOPS the device (observed on a clean 1.18 flash:
  "Signature|privileged permissions not in privapp-permissions allowlist:
  {com.repository.glasses.btmanager: BLUETOOTH_PRIVILEGED}"). MODIFY_PHONE_STATE
  is added as the second entry so the block is multi-permission and parses
  reliably; btmanager legitimately uses it for HFP-HF call state. Keep the
  block comment-free below.
-->
<permissions>
    <privapp-permissions package="com.repository.glasses.btmanager">
        <permission name="android.permission.BLUETOOTH_PRIVILEGED"/>
        <permission name="android.permission.MODIFY_PHONE_STATE"/>
    </privapp-permissions>
</permissions>
