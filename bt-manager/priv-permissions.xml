<?xml version="1.0" encoding="utf-8"?>
<!--
  privapp-permissions-com.repository.glasses.btmanager.xml

  Grants the signature|privileged permissions required by the bt-manager APK
  on a device where the app is NOT signed with the platform key. Required
  for BluetoothA2dpSink.connect / BluetoothHeadsetClient.connect / setConnectionPolicy
  used by ProfileAutoConnector to bring HFP-HF and A2DP Sink up after pairing.

  IMPORTANT: do NOT add comments inside the <privapp-permissions> block.
  Android 12 silently drops the entire <privapp-permissions> block when a
  comment node appears as a sibling to <permission> children if there's only
  one permission element -- the parser advances past the comment to the
  closing tag, and the priv-app then fails systemReady() check.
  Multi-permission blocks (like the listener xml) tolerate inline comments,
  but single-permission blocks do not. Keep this file comment-free below.
-->
<permissions>
    <privapp-permissions package="com.repository.glasses.btmanager">
        <permission name="android.permission.BLUETOOTH_PRIVILEGED"/>
    </privapp-permissions>
</permissions>
