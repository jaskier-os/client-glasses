# Environment configuration for the Rokid glasses listener project.
#
# This is an Android app: the production build itself has NO server endpoint and
# NO secrets -- the glasses talk to the companion phone over Bluetooth RFCOMM and
# (for file sync) Wi-Fi Direct, with the peer address negotiated at runtime. The
# variables below are ONLY consumed by the optional developer/deploy/test shell
# scripts under sthal/, test/, capture/test/, *-daemon/. None are required to
# build the APK. Copy this file to .env (gitignored) and set what you need.

# ---- ADB device targeting (optional) -------------------------------------
# Serial of the glasses as shown by `adb devices`. Leave blank to auto-pick the
# only attached device. Used by deploy/test helper scripts.
ADB_SERIAL=
# Some scripts use these aliases instead of ADB_SERIAL:
GLASSES_SERIAL=
# Serial of the companion phone (for end-to-end audio/translation tests).
PHONE_SERIAL=

# ---- Native / model toolchains (optional) --------------------------------
# Android NDK location for the native daemons (glasses-power-daemon, touchpad-
# daemon, sthal/acd-probe). If unset the build scripts probe $HOME/Android/Sdk/ndk.
ANDROID_NDK=
# Qualcomm QAIRT (QNN) SDK root, only needed to RE-COMPILE the wake-word ONNX
# graphs to Hexagon HTP via sthal/tools/compile_onnx_to_qnn.sh. The prebuilt
# .bin/.onnx model assets are already committed, so this is not needed to build.
QNN_SDK_ROOT=
# Optional override for the QAIRT env bootstrap script and clang shim dir.
QAIRT_ENV=
QAIRT_BIN_SHIM=

# ---- Optional cross-service integration ----------------------------------
# Path to a transcriber service .env that test/test_mics.sh can wire an audio
# dump path into. Leave blank to skip the transcriber integration entirely.
TRANSCRIBER_ENV=
